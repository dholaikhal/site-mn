---
import Base from '../layouts/Base.astro';
import { MEMBERS, MEMBER_CITIES } from '../data/members';
import { ADMINS } from '../data/team';
import { PROJECTS } from '../data/org';
import { identicon } from '../lib/avatar';

const admins = new Set(ADMINS.map((a) => a.user));
const byCity = MEMBER_CITIES.map((c) => ({ c, n: MEMBERS.filter((m) => m.city === c).length })).sort((a, b) => b.n - a.n);
const shells = ['bash', 'zsh', 'fish', 'nu'].map((s) => ({ s, n: MEMBERS.filter((m) => m.shell === s).length }));
const pages = MEMBERS.filter((m) => m.page).length;
const joined = (d: string) => new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
const members = [...MEMBERS].sort((a, b) => a.user.localeCompare(b.user));
---

<Base title="Members" description="Everyone with an account on mukto.net, their .plan files and their web pages.">
  <div class="wrap page-head">
    <p class="cmd mono">$ finger @mukto.net</p>
    <h1>Members</h1>
    <p class="lede">{MEMBERS.length} accounts, {pages} web pages, {MEMBER_CITIES.length} cities. The first cohort, invited between July and October.</p>
  </div>

  <div class="wrap page-body">
    <div class="stats">
      <div>
        <h2 class="small">Where</h2>
        <ul class="bars">
          {
            byCity.slice(0, 8).map(({ c, n }) => (
              <li>
                <span class="lbl">{c}</span>
                <span class="track"><span style={`width:${(n / byCity[0].n) * 100}%`} /></span>
                <span class="n">{n}</span>
              </li>
            ))
          }
        </ul>
        <p class="also">Also: {byCity.slice(8).map((x) => x.c).join(', ')}.</p>
      </div>
      <div>
        <h2 class="small">Login shell</h2>
        <ul class="bars">
          {
            shells.map(({ s, n }) => (
              <li>
                <span class="lbl mono">{s}</span>
                <span class="track"><span style={`width:${(n / MEMBERS.length) * 100}%`} /></span>
                <span class="n">{n}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <p class="filter">
      <label for="q">Find someone</label>
      <input id="q" type="search" class="mono" placeholder="username, name, city, anything in their .plan" autocomplete="off" />
      <span class="shown" aria-live="polite"></span>
    </p>

    <ul class="members" id="members">
      {
        members.map((m) => (
          <li id={m.user} data-text={`${m.user} ${m.name ?? ''} ${m.city} ${m.plan}`.toLowerCase()}>
            <span class="icon" set:html={identicon(m.user, 44)} />
            <div class="info">
              <p class="user">
                <span class="mono">~{m.user}</span>
                {m.name && <span class="name">{m.name}</span>}
                {admins.has(m.user) && <a class="role" href={`/team/#${m.user}`}>admin</a>}
              </p>
              <p class="facts">
                {m.city} · joined {joined(m.joined)} · <span class="mono">{m.shell}</span>
                {m.repos > 0 && <> · {m.repos} repos</>}
              </p>
              <p class="plan">
                <span class="mono k">Plan:</span> {m.plan || <span class="none">No plan.</span>}
              </p>
              {m.page && <p class="page mono">mukto.net/~{m.user}</p>}
            </div>
          </li>
        ))
      }
    </ul>

    <h2 id="projects">Projects on the forge</h2>
    <ul class="projects">
      {
        PROJECTS.map((p) => (
          <li>
            <p class="repo mono">{p.repo}</p>
            <p>{p.what}</p>
            <p class="lang">{p.lang}</p>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<script>
  const q = document.querySelector<HTMLInputElement>('#q')!;
  const items = [...document.querySelectorAll<HTMLElement>('#members > li')];
  const shown = document.querySelector<HTMLElement>('.shown')!;
  q.addEventListener('input', () => {
    const term = q.value.trim().toLowerCase();
    let n = 0;
    for (const li of items) {
      const hit = !term || li.dataset.text!.includes(term);
      li.hidden = !hit;
      if (hit) n++;
    }
    shown.textContent = term ? `${n} of ${items.length}` : '';
  });
</script>

<style>
  .cmd {
    color: var(--muted);
    margin-bottom: 0.5rem;
  }
  .stats {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: 2rem 4rem;
    margin-bottom: 2.5rem;
    max-width: 60rem;
  }
  .small {
    font-size: var(--step-0);
    margin-bottom: 0.6rem;
  }
  .bars {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.3rem;
    font-size: var(--step--1);
  }
  .bars li {
    display: grid;
    grid-template-columns: 7rem 1fr 2rem;
    gap: 0.75rem;
    align-items: center;
  }
  .track {
    height: 8px;
    background: var(--surface);
    border-radius: 2px;
    overflow: hidden;
  }
  .track span {
    display: block;
    height: 100%;
    background: var(--flag);
  }
  .n {
    text-align: right;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }
  .also {
    font-size: var(--step--1);
    color: var(--muted);
    margin-top: 0.5rem;
  }
  .filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    max-width: none;
    margin-bottom: 1.5rem;
  }
  .filter label {
    font-weight: 600;
  }
  .filter input {
    flex: 1 1 18rem;
    max-width: 30rem;
    font: inherit;
    font-family: var(--mono);
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--muted);
    border-radius: 3px;
    padding: 0.45em 0.7em;
  }
  .shown {
    color: var(--muted);
    font-size: var(--step--1);
  }
  .members {
    list-style: none;
    padding: 0;
    margin: 0 0 3rem;
    max-width: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: 0 2rem;
  }
  .members li {
    display: flex;
    gap: 0.9rem;
    padding: 0.9rem 0;
    border-top: 1px solid var(--rule);
    scroll-margin-top: 1rem;
  }
  .members li:target {
    background: var(--green-soft);
    outline: 2px solid var(--flag);
    outline-offset: 4px;
  }
  .icon {
    line-height: 0;
    flex: none;
    border-radius: 3px;
    overflow: hidden;
    height: 44px;
  }
  .info {
    min-width: 0;
  }
  .info p {
    margin: 0;
  }
  .user {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.6rem;
  }
  .user .mono {
    font-weight: 700;
  }
  .name {
    color: var(--muted);
    font-size: var(--step--1);
  }
  .role {
    font-size: 0.8rem;
    color: var(--flag);
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 0 0.5em;
    text-decoration: none;
  }
  .facts {
    font-size: var(--step--1);
    color: var(--muted);
  }
  .plan {
    margin-top: 0.25rem !important;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }
  .k {
    color: var(--muted);
    font-size: 0.85em;
  }
  .none {
    color: var(--muted);
  }
  .page {
    font-size: 0.85rem;
    color: var(--flag);
    margin-top: 0.2rem !important;
  }
  .projects {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: 0 2rem;
  }
  .projects li {
    border-top: 1px solid var(--rule);
    padding: 0.9rem 0 0.6rem;
  }
  .projects p {
    margin: 0 0 0.2rem;
  }
  .repo {
    font-weight: 700;
    color: var(--flag);
  }
  .lang {
    font-size: var(--step--1);
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .stats {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
