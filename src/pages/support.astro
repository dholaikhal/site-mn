---
import Base from '../layouts/Base.astro';
import { ORG } from '../data/org';
---

<Base title="Support us" description="Volunteer, contribute money, or sponsor hardware, bandwidth or a venue for mukto.net.">
  <div class="wrap page-head">
    <h1>Support mukto.net</h1>
    <p class="lede">The server costs ৳3,300 a month and events cost about as much again. You can help with time, money or things.</p>
  </div>

  <div class="wrap page-body">
    <section class="ways">
      <div>
        <h2>Give time</h2>
        <p>
          Help run an event, teach a Shell Saturday session, translate a guide, or learn to look
          after the server. Say so in <code>#adda</code>.
        </p>
        <p><a href="/team/">Who to talk to</a></p>
      </div>
      <div>
        <h2>Give money</h2>
        <p>
          Members chip in by bKash for the server. ~arpita keeps the spreadsheet; ask to see it.
        </p>
        <p>
          Not a member? <a href="/join/?help=donate#form">Tell us</a> and we'll get in touch.
        </p>
      </div>
      <div>
        <h2>Give things</h2>
        <p>
          Old servers, bandwidth, a room for a Saturday, printing. Supporters get thanked here.
        </p>
        <p><a href={`mailto:${ORG.email.hello}?subject=Sponsoring%20mukto.net`}>{ORG.email.hello}</a></p>
      </div>
    </section>

    <h2>Supporters</h2>
    <p>
      A rooftop in Dhanmondi, a lab in Mohakhali and a room in Agrabad, from hosts who asked not to
      be named.
    </p>
  </div>
</Base>

<style>
  .ways {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 2.5rem;
    margin-bottom: 2rem;
  }
  .ways > div {
    border-top: 2px solid var(--ink);
    padding-top: 1rem;
  }
  .ways h2 {
    font-size: var(--step-1);
  }
  .groups {
    list-style: none;
    padding: 0;
    font-size: var(--step--1);
  }
  .groups li {
    padding: 0.3rem 0;
    border-bottom: 1px solid var(--rule);
    font-weight: 600;
  }
  .groups span {
    display: block;
    font-weight: 400;
    color: var(--muted);
  }
  .more {
    font-size: var(--step--1);
    margin-top: 0.75rem;
  }
  @media (max-width: 860px) {
    .ways {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
