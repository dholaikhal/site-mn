---
import { PILLARS } from '../data/site';

interface Props {
  lang?: 'en' | 'bn';
}
const bn = Astro.props.lang === 'bn';
---

<ul class="pillars">
  {
    PILLARS.map((p) => (
      <li>
        <a href={p.href}>
          <span class="verb">{bn ? p.bn : p.verb}</span>
          <span class="other" lang={bn ? 'en' : 'bn'}>
            {bn ? p.verb : p.bn}
          </span>
        </a>
        <p>{bn ? p.lineBn : p.line}</p>
      </li>
    ))
  }
</ul>

<style>
  .pillars {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem 2rem;
  }
  li {
    border-top: 2px solid var(--ink);
    padding-top: 0.75rem;
  }
  a {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    color: var(--ink);
    text-decoration: none;
  }
  a:hover .verb {
    text-decoration: underline;
    text-decoration-color: var(--red);
    text-decoration-thickness: 3px;
  }
  .verb {
    font-size: clamp(2rem, 3.6vw, 2.8rem);
    font-weight: 750;
    font-stretch: 125%;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .other {
    color: var(--muted);
  }
  p {
    margin: 0.4rem 0 0;
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .pillars {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 480px) {
    .pillars {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
