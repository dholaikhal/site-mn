---
import Base from '../../layouts/Base.astro';
import Terminal from '../../components/Terminal.astro';
import InterestForm from '../../components/InterestForm.astro';
---

<Base title="Join" description="mukto.net accounts are invite-only for now. Claim your ~name and get a login when sign-ups open.">
  <div class="wrap page-head">
    <h1>Join mukto.net</h1>
    <p class="lede">
      Accounts are invite-only for now. Put your name down and we'll send you a login when
      sign-ups open.
    </p>
  </div>

  <div class="wrap page-body">
    <h2>How joining will work</h2>
    <ol class="how">
      <li>Make an SSH key (<a href="/learn/ssh-keys/">how</a>).</li>
      <li>Run <code>ssh join@mukto.net</code>.</li>
      <li>Pick a username, paste your key, agree to the <a href="/conduct/">code of conduct</a> and <a href="/rules/">rules</a>.</li>
      <li>Log in with <code>ssh you@mukto.net</code>. Your page is at <code>mukto.net/~you</code>.</li>
    </ol>

    <h2 id="try">Try it now</h2>
    <p>
      Until sign-ups open, this runs in your browser and saves your place. Press <kbd>Enter</kbd>.
    </p>
    <Terminal />

    <h2 id="form">Prefer a form?</h2>
    <p>Same list, more questions. Only email is required.</p>
    <InterestForm />
  </div>
</Base>

<style>
  .how {
    padding-left: 1.4em;
  }
  .how li {
    margin-bottom: 0.5rem;
  }
  .how li::marker {
    font-weight: 700;
    color: var(--flag);
  }
  kbd {
    border: 1px solid var(--muted);
    border-bottom-width: 2px;
    border-radius: 3px;
    padding: 0 0.35em;
  }
</style>
