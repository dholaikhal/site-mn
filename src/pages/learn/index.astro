---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Learn" description="Free guides from mukto.net: SSH keys, shared Unix servers, your first web page.">
  <div class="wrap page-head">
    <h1>Learn</h1>
    <p class="lede">
      Short, practical guides. Start here if you've never logged into a server before.
    </p>
  </div>

  <div class="wrap page-body">
    <ul class="guides">
      {
        guides.map((g) => (
          <li>
            <h2>
              <a href={`/learn/${g.id}/`}>{g.data.title}</a>
            </h2>
            <p>{g.data.summary}</p>
          </li>
        ))
      }
    </ul>

    <h2>Write the next one</h2>
    <p>
      Guides will be written by members, in Bangla and English, and kept in git so anyone can fix
      them. If there's something you'd like to teach, or translate,
      <a href="/join/?help=docs#form">tell us</a>.
    </p>
  </div>
</Base>

<style>
  .guides {
    list-style: none;
    padding: 0;
    margin: 0 0 3rem;
  }
  .guides li {
    border-top: 1px solid var(--rule);
    padding-block: 1.25rem 0.25rem;
  }
  .guides h2 {
    font-size: var(--step-1);
    margin-bottom: 0.3rem;
  }
  .guides p {
    color: var(--muted);
  }
</style>
