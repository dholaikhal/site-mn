---
import Base from '../../layouts/Base.astro';
import Avatar from '../../components/Avatar.astro';
import { EVENTS, PROGRAMMES, now } from '../../data/events';
import { ADMINS } from '../../data/team';

export function getStaticPaths() {
  return EVENTS.map((e) => ({ params: { slug: e.slug }, props: { event: e } }));
}

const { event: e } = Astro.props;
const isPast = new Date(e.end) < now;
const fmt = (o: Intl.DateTimeFormatOptions) => new Date(e.start).toLocaleString('en-GB', { timeZone: 'Asia/Dhaka', ...o });
const endTime = new Date(e.end).toLocaleString('en-GB', { timeZone: 'Asia/Dhaka', hour: '2-digit', minute: '2-digit' });
const programme = PROGRAMMES.find((p) => p.id === e.programme);
const officer = (u: string) => ADMINS.find((o) => o.user === u);
---

<Base title={e.title} description={e.summary}>
  <div class="wrap page-head">
    <p class="crumb"><a href="/events/">Events</a>{programme && <span> / {programme.name}</span>}</p>
    <h1>{e.title}</h1>
    <p class="lede">{e.summary}</p>
  </div>

  <div class="wrap page-body grid">
    <div>
      {
        isPast && e.recap && (
          <>
            <h2>What happened</h2>
            <p>{e.recap}</p>
          </>
        )
      }
      {
        e.agenda && (
          <>
            <h2>Schedule</h2>
            <table class="agenda">
              <tbody>
                {e.agenda.map(([t, item]) => (
                  <tr>
                    <th scope="row" class="mono">{t}</th>
                    <td>{item}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </>
        )
      }
      {
        e.bring && (
          <>
            <h2>Bring</h2>
            <ul>
              {e.bring.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          </>
        )
      }
      <h2>Hosts</h2>
      <ul class="hosts">
        {
          e.hosts.map((u) => {
            const o = officer(u);
            return (
              <li>
                <Avatar user={u} avatar={o?.avatar} size={40} />
                <a href={`/members/#${u}`} class="mono">~{u}</a>
              </li>
            );
          })
        }
      </ul>
    </div>

    <aside class="facts">
      <dl>
        <dt>When</dt>
        <dd>
          {fmt({ weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })}<br />
          {fmt({ hour: '2-digit', minute: '2-digit' })}–{endTime} BST
        </dd>
        <dt>Where</dt>
        <dd>
          {e.venue}
          {e.city !== 'Online' && <span class="city">{e.city}</span>}
        </dd>
        {
          isPast && e.attended && (
            <>
              <dt>Came</dt>
              <dd>{e.attended} people</dd>
            </>
          )
        }
        {
          !isPast && e.capacity && (
            <>
              <dt>Going</dt>
              <dd>
                {e.rsvps} of {e.capacity} places
              </dd>
            </>
          )
        }
        <dt>Cost</dt>
        <dd>Free</dd>
      </dl>
      {
        !isPast && (
          <p class="acts">
            <a class="button" href="/join/?use=events#form">I'm going</a>
            <a class="button ghost" href={`/events/${e.slug}.ics`}>Add to calendar</a>
          </p>
        )
      }
    </aside>
  </div>
</Base>

<style>
  .crumb {
    margin-bottom: 0.75rem;
    color: var(--muted);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 20rem;
    gap: 2rem 4rem;
    align-items: start;
  }
  .grid h2 {
    font-size: var(--step-1);
    margin-top: 2rem;
  }
  .grid h2:first-child {
    margin-top: 0;
  }
  .agenda {
    border-collapse: collapse;
    width: 100%;
    max-width: 40rem;
  }
  .agenda th,
  .agenda td {
    text-align: left;
    padding: 0.45rem 1rem 0.45rem 0;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
  }
  .agenda th {
    color: var(--flag);
    width: 4.5rem;
  }
  .hosts {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
  }
  .hosts li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .facts {
    border: 1px solid var(--rule);
    border-top: 4px solid var(--flag);
    border-radius: 3px;
    padding: 1.25rem;
  }
  dl {
    margin: 0;
  }
  dt {
    font-size: var(--step--1);
    color: var(--muted);
  }
  dd {
    margin: 0 0 0.9rem;
  }
  .city {
    display: block;
  }
  .acts {
    display: grid;
    gap: 0.5rem;
    margin: 0;
  }
  .acts .button {
    justify-content: center;
  }
  @media (max-width: 860px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .facts {
      order: -1;
    }
  }
</style>
