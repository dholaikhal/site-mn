---
import Base from '../layouts/Base.astro';
import Avatar from '../components/Avatar.astro';
import { ADMINS } from '../data/team';
---

<Base title="Team" description="The volunteers who run the mukto.net server and events.">
  <div class="wrap page-head">
    <h1>Team</h1>
    <p class="lede">
      Six volunteers run the server and the events, mostly from <code>#ops</code> and
      <code>#events</code> on IRC.
    </p>
  </div>

  <div class="wrap page-body">
    <ul class="admins">
      {
        ADMINS.map((a) => (
          <li id={a.user}>
            <Avatar user={a.user} avatar={a.avatar} photo={a.photo} size={112} label={a.name ?? a.user} />
            <div>
              <p class="does">
                {a.does} <span lang="bn">{a.doesBn}</span>
              </p>
              <h2>{a.name ?? `~${a.user}`}</h2>
              {a.name && <p class="handle mono">~{a.user}</p>}
              <blockquote>{a.tagline}</blockquote>
            </div>
          </li>
        ))
      }
    </ul>

    <h2 class="sec">Helping out</h2>
    <p>
      No application. Offer to do something in <code>#ops</code> or <code>#events</code>, then do it.
      Regulars get asked to become admins.
    </p>
  </div>
</Base>

<style>
  .admins {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    max-width: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr));
    gap: 0 2.5rem;
  }
  .admins > li {
    display: flex;
    gap: 1.25rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--rule);
    scroll-margin-top: 1rem;
  }
  .admins > li:target {
    outline: 2px solid var(--flag);
    outline-offset: 6px;
  }
  .does {
    font-size: var(--step--1);
    color: var(--flag);
    font-weight: 600;
    margin: 0 0 0.1rem;
  }
  .does span {
    color: var(--muted);
    font-weight: 400;
    margin-left: 0.3rem;
  }
  h2 {
    margin: 0;
    font-size: var(--step-1);
  }
  .sec {
    font-size: var(--step-2);
    margin: 2rem 0 0.75rem;
  }
  .handle {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }
  blockquote {
    margin: 0.6rem 0 0;
    padding-left: 0.8rem;
    border-left: 2px solid var(--rule);
    line-height: 1.45;
  }
  @media (max-width: 480px) {
    .admins > li {
      gap: 0.9rem;
    }
    .admins :global(.avatar) {
      width: 64px !important;
      height: 64px !important;
    }
  }
</style>
