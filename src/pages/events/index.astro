---
import Base from '../../layouts/Base.astro';
import EventRow from '../../components/EventRow.astro';
import { PROGRAMMES, past, upcoming } from '../../data/events';

const came = past.reduce((s, e) => s + (e.attended ?? 0), 0);
---

<Base title="Events" description="Shell Saturdays, first PR nights, install-fests and localisation sprints, in Dhaka, other cities and online.">
  <div class="wrap page-head">
    <h1>Events</h1>
    <p class="lede">Free, open to anyone, mostly on Saturdays. {came} people have come to {past.length} so far.</p>
    <p class="subs">
      <a class="button ghost" href="/events.ics">Subscribe (.ics)</a>
      <a class="button ghost" href="/join/?help=events#form">Help organise one</a>
    </p>
  </div>

  <div class="wrap page-body">
    <h2>Coming up</h2>
    <ul class="list">{upcoming.map((e) => <EventRow event={e} />)}</ul>

    <h2>What runs every month</h2>
    <ul class="progs">
      {
        PROGRAMMES.map((p) => (
          <li>
            <h3>{p.name}</h3>
            <p class="cad">
              {p.cadence} · {p.where}
            </p>
            <p>{p.what}</p>
          </li>
        ))
      }
    </ul>

    <h2>Before</h2>
    <ul class="list">{past.map((e) => <EventRow event={e} past />)}</ul>

    <h2>Run something with us</h2>
    <p>
      Got a room, a campus club or a talk? <a href="/join/?help=events#form">Tell us</a>. We'll bring
      the server and the handouts.
    </p>
  </div>
</Base>

<style>
  .subs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .list {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    max-width: 60rem;
  }
  .progs {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: 1rem 2rem;
  }
  .progs li {
    border-top: 2px solid var(--ink);
    padding-top: 0.75rem;
  }
  .progs h3 {
    margin-bottom: 0.2rem;
  }
  .progs p {
    margin: 0 0 0.4rem;
  }
  .cad {
    font-size: var(--step--1);
    color: var(--flag);
    font-weight: 600;
  }
</style>
