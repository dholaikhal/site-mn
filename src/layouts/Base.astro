---
import '@fontsource-variable/anek-bangla/standard.css';
import '@fontsource/iosevka/400.css';
import '@fontsource/iosevka/700.css';
import '../styles/global.css';
import { FOOTER, NAV } from '../data/site';
import { ORG, SAMPLE_DATA } from '../data/org';

interface Props {
  title?: string;
  description?: string;
  lang?: 'en' | 'bn';
}

const {
  title,
  description = "A community-run commons for Bangladesh's tech people: shell accounts, git, hosting, open-source work, guides and events.",
  lang = 'en',
} = Astro.props;

const fullTitle = title
  ? `${title} | mukto.net`
  : lang === 'bn'
    ? 'mukto.net: বড় প্ল্যাটফর্মের বেড়ার বাইরে, নিজেদের একটা ঘর'
    : 'mukto.net: your safe home in a world of walled gardens';
const path = Astro.url.pathname;
const isBn = lang === 'bn';
const canonical = new URL(path, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL('/', Astro.site)} />
    <link rel="alternate" hreflang="bn" href={new URL('/bn/', Astro.site)} />
    <link rel="alternate" type="text/calendar" title="mukto.net events" href="/events.ics" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f6f7f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121514" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="mukto.net" />
  </head>
  <body>
    <a class="skip visually-hidden" href="#main">{isBn ? 'মূল অংশে যান' : 'Skip to content'}</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="mark" href={isBn ? '/bn/' : '/'} aria-label="mukto.net home">
          <svg class="mark-icon" viewBox="0 0 32 32" aria-hidden="true"
            ><path d="M5.5 15.5 16 5.5l10.5 10V26h-21z" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linejoin="round"
            ></path><path d="M10 19.2c1.6-2.2 3.6-2.2 5.4-.6s3.8 1.6 5.6-.8" fill="none" stroke="var(--red)" stroke-width="2.6" stroke-linecap="round"
            ></path></svg
          >
          <span class="mono">mukto.net</span>
        </a>
        <nav aria-label={isBn ? 'প্রধান' : 'Main'}>
          <ul>
            {
              NAV.map((item) => (
                <li>
                  <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li>
              {isBn ? <a href="/" lang="en">English</a> : <a href="/bn/" lang="bn">বাংলা</a>}
            </li>
          </ul>
        </nav>
        <a class="button join" href="/join/">{isBn ? 'যুক্ত হোন' : 'Join'}</a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap foot">
        <div class="foot-org">
          <p class="foot-name"><span class="mono">mukto.net</span> <span lang="bn">মুক্ত</span></p>
          <p>{ORG.status}</p>
          <p>
            Founded in Dhaka, 13 June 2026. Server in {ORG.hosting}.<br />
            <a href={`mailto:${ORG.email.hello}`}>{ORG.email.hello}</a>
          </p>
        </div>
        {
          FOOTER.map((col) => (
            <div>
              <h2 class="foot-h">{col.title}</h2>
              <ul class="foot-links">
                {col.links.map((l) => (
                  <li>
                    <a href={l.href}>{l.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      {
        SAMPLE_DATA && (
          <p class="wrap sample">
            Sample data: members, team, events and accounts on this site are placeholders while we
            find out who wants mukto.net. <a href="/join/">The interest list</a> is real.
          </p>
        )
      }
      <div class="statusline mono" aria-label="Page status">
        <span class="seg seg-host">[mukto]</span>
        <span class="seg" data-bn-date>--</span>
        <span class="seg" data-clock>--:--</span>
        <span class="seg" data-cookies>cookies 0</span>
        <span class="seg" data-third>3rd-party 0</span>
        <span class="seg" data-weight>-- kB</span>
      </div>
    </footer>

    <script>
      import { banglaDateString } from '../lib/bangla';
      const now = new Date();
      const bn = document.querySelector('[data-bn-date]');
      if (bn) bn.textContent = banglaDateString(now);
      const clock = document.querySelector('[data-clock]');
      const tick = () => {
        if (clock)
          clock.textContent =
            new Date().toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Dhaka' }) + ' BST';
      };
      tick();
      setInterval(tick, 30_000);
      addEventListener('load', () => {
        const entries = [
          ...performance.getEntriesByType('navigation'),
          ...performance.getEntriesByType('resource'),
        ] as PerformanceResourceTiming[];
        const bytes = entries.reduce((sum, e) => sum + (e.encodedBodySize || 0), 0);
        // Counted, not claimed: cookies this page can see, and requests to other origins.
        const cookies = document.cookie.split(';').filter((c) => c.trim()).length;
        const third = entries.filter((e) => e.name.startsWith('http') && new URL(e.name).origin !== location.origin).length;
        const c = document.querySelector('[data-cookies]');
        const t = document.querySelector('[data-third]');
        if (c) c.textContent = `cookies ${cookies}`;
        if (t) t.textContent = `3rd-party ${third}`;
        const weight = document.querySelector('[data-weight]');
        if (weight && bytes) weight.textContent = `${Math.round(bytes / 1024)} kB`;
      });
    </script>
  </body>
</html>

<style>
  .skip:focus {
    position: fixed !important;
    top: 0.5rem;
    left: 0.5rem;
    width: auto;
    height: auto;
    clip-path: none;
    background: var(--paper);
    padding: 0.5rem 1rem;
    z-index: 10;
  }

  .site-header {
    border-bottom: 1px solid var(--rule);
    background: var(--paper);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 0.75rem 2rem;
    min-height: 4rem;
    flex-wrap: wrap;
  }
  .mark {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink);
    text-decoration: none;
    font-size: 1.15rem;
    font-weight: 700;
  }
  .mark-icon {
    width: 1.6rem;
    height: 1.6rem;
    color: var(--flag);
  }
  nav {
    margin-left: auto;
  }
  nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.3rem;
    margin: 0;
    padding: 0;
    max-width: none;
  }
  nav a {
    color: var(--ink);
    text-decoration: none;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--red);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
  }
  .join {
    padding: 0.35em 1em;
  }

  @media (max-width: 820px) {
    .bar {
      padding-block: 0.75rem;
    }
    .join {
      margin-left: auto;
    }
    nav {
      order: 3;
      margin-left: 0;
      width: 100%;
    }
    nav ul {
      gap: 0.25rem 1rem;
      font-size: 1rem;
    }
  }

  .site-footer {
    margin-top: 4rem;
    border-top: 1px solid var(--rule);
    font-size: var(--step--1);
    color: var(--muted);
  }
  .foot {
    display: grid;
    grid-template-columns: 2fr repeat(2, 1fr);
    gap: 2rem;
    padding-block: 3rem 2rem;
  }
  .foot p {
    max-width: 36ch;
  }
  .foot-name {
    font-size: 1.1rem;
    color: var(--ink);
    font-weight: 700;
  }
  .foot-h {
    font-size: var(--step--1);
    font-stretch: 100%;
    color: var(--ink);
    margin-bottom: 0.6rem;
  }
  .foot-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.35rem;
  }
  .foot-links a {
    color: var(--muted);
    text-decoration: none;
  }
  .foot-links a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  .sample {
    padding-bottom: 1.25rem;
    margin: 0 auto;
    max-width: var(--wide);
  }
  .statusline {
    display: flex;
    flex-wrap: wrap;
    background: var(--term);
    color: var(--term-ink);
    font-size: 0.8rem;
    line-height: 1.9;
  }
  .seg {
    padding: 0 0.9em;
    border-right: 1px solid #2c3431;
  }
  .seg-host {
    background: #00684b;
    color: #f6f7f5;
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .foot {
      grid-template-columns: repeat(2, 1fr);
    }
    .foot-org {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 520px) {
    .foot {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
