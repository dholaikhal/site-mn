---
import { cat, face, identicon, landscape, monogram, pixel, tux } from '../lib/avatar';
import type { Avatar } from '../data/team';

interface Props {
  user: string;
  avatar?: Avatar;
  photo?: string;
  size?: number;
  label?: string;
}
const { user, avatar, photo, size = 96, label } = Astro.props;

let svg = '';
if (!photo) {
  if (!avatar) svg = identicon(user, size);
  else if (avatar.kind === 'face') svg = face(avatar.face, size);
  else if (avatar.kind === 'tux') svg = tux(avatar.bg, size);
  else if (avatar.kind === 'cat') svg = cat(avatar.bg, avatar.fur, size);
  else if (avatar.kind === 'landscape') svg = landscape(size);
  else if (avatar.kind === 'pixel') svg = pixel(avatar.color, avatar.bg, size);
  else svg = monogram(avatar.text, avatar.bg, '#f6f7f5', size);
}
---

{
  photo ? (
    <img class="avatar" src={photo} alt={label ?? ''} width={size} height={size} loading="lazy" />
  ) : (
    <span class="avatar" style={`width:${size}px;height:${size}px`} set:html={svg} />
  )
}

<style>
  .avatar {
    display: inline-block;
    flex: none;
    border-radius: 4px;
    overflow: hidden;
    line-height: 0;
    object-fit: cover;
  }
  .avatar :global(svg) {
    width: 100%;
    height: 100%;
  }
</style>
